# Salin sebagai docker/.env pada server Docker. Jangan commit file hasil salinan.
NODE_ENV=production
APP_URL=https://example.com
JWT_SECRET=ganti-dengan-output-node-randomBytes-48-base64url
JWT_EXPIRES_IN=7d

# Nama ini harus tetap sentuhan_kecil_db karena database/schema.sql memakainya.
MYSQL_DATABASE=sentuhan_kecil_db
MYSQL_USER=aera_app
MYSQL_PASSWORD=ganti-password-db-aplikasi-panjang
MYSQL_ROOT_PASSWORD=ganti-password-root-db-lebih-panjang

# Reset password wajib memakai SMTP pada production.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=username
SMTP_PASS=password-aplikasi-atau-api-key
MAIL_FROM="Aera Baby Spa <no-reply@example.com>"

# Hanya dipakai saat membuat akun admin pertama.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=Administrator Aera Baby Spa
BOOTSTRAP_ADMIN_PASSWORD=ganti-password-admin-minimal-12-karakter
