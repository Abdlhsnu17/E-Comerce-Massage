[Unit]
Description=Aera Baby Spa web application
After=network.target mariadb.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/aera-baby-spa
EnvironmentFile=/etc/aera-baby-spa.env
ExecStart=/usr/bin/node server/server.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/www/aera-baby-spa/public/uploads

[Install]
WantedBy=multi-user.target
