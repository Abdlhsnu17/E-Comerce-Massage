# Salin file ini menjadi .env lalu sesuaikan bila perlu.
PORT=3000

# Database MySQL / MariaDB lokal (XAMPP default: user root tanpa password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lokamart_db

# Kunci penanda tangan cookie sesi. Wajib string acak minimal 32 karakter.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
